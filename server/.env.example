# ==========================================
# STUDYSPHERE BACKEND CONFIGURATION
# ==========================================

PORT=5000

# ------------------------------------------
# MONGODB ATLAS CONNECTION STRING
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Example: mongodb+srv://admin:mypassword123@cluster0.abcde.mongodb.net/studysphere?retryWrites=true&w=majority
# ------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/studysphere?retryWrites=true&w=majority

# Local fallback option if testing locally:
# MONGO_URI=mongodb://127.0.0.1:27017/studysphere

# JWT Authentication Secret
JWT_SECRET=studysphere_super_secret_jwt_key_2026_production

# Frontend Client URL (for CORS and WebSockets)
CLIENT_URL=http://localhost:5173
