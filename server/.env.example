# ==========================================
# STUDYSPHERE BACKEND CONFIGURATION
# ==========================================

PORT=5000

# MongoDB Connection String (Atlas or Local)
# Replace with your connection URI from your MongoDB Atlas dashboard (Connect -> Drivers)
MONGO_URI=YOUR_MONGODB_URI_HERE

# Local fallback option if testing locally:
# MONGO_URI=mongodb://127.0.0.1:27017/studysphere

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS and WebSockets)
CLIENT_URL=http://localhost:5173
